# 服务端口
PORT=3001

# SQLite 数据库文件路径（相对后端目录）
DATABASE_PATH=./data/blueberry.db

# 模型服务（OpenAI 兼容格式，阶段 1 使用；阶段 0 仅占位）
# 默认指向本地 Ollama 的 OpenAI 兼容端点
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
DEFAULT_MODEL=qwen2.5:7b

# ── 轻量情绪分析管道（2026-10-19）────────────────────────────
# 专门跑「四维情绪增量」的小模型；留空 = 复用主模型
# 建议填便宜快的模型（如 DeepSeek Flash 一类），max_tokens 固定 100
EMOTION_MODEL=
EMOTION_MAX_TOKENS=100
# 小模型超时就回退关键词规则，不拖住主对话
EMOTION_TIMEOUT_MS=5000
# off = 关闭轻量分析，完全走关键词兜底
EMOTION_ANALYZER=on

# ── Ombre Brain（OB）记忆专线（2026-10-19）──────────────────
# 阿里云 VPS 上的 Ombre Brain 服务地址（不带结尾斜杠）
OB_BASE_URL=
# Ombre MCP Token（只存后端，绝不下发前端）
OB_API_TOKEN=
# 检索/归档超时；归档是后台异步，超时只记日志
OB_TIMEOUT_MS=3500

# ── 消息时间戳（2026-10-19）─────────────────────────────────
# on = 送模型前给每条消息动态加 [Tue … CST · +9h 44m]；存档永远不写
# off = 回到原生行为
MESSAGE_TIMESTAMPS=on

# ── Remember-Me 相册侧车（2026-10-19）──────────────────────
# 图像记忆 Dashboard 地址；没起也不影响本地相册
REMEMBER_ME_URL=http://127.0.0.1:8787
