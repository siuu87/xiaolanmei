@echo off
setlocal EnableDelayedExpansion
cd /d "%~dp0..\recipe-nook"

rem ==============================================================
rem  recipe-nook (Food Nook) one-click setup - Windows
rem
rem  Usage (double-click = build if needed, then start):
rem    setup-recipe-nook.bat           build if needed + start
rem    setup-recipe-nook.bat check     health check only, do not start
rem    setup-recipe-nook.bat build     build the recipe library only
rem    setup-recipe-nook.bat rebuild   force rebuild the recipe library
rem
rem  It does five things, and every step is idempotent, so running
rem  it again is always safe and never touches your meal log:
rem    1 create .venv   2 install deps   3 create .env
rem    4 build recipe library (only when empty)   5 start on port 8790
rem
rem  NOTE 1: this file is deliberately ASCII-only. cmd.exe reads .bat
rem  files using the system code page, so non-ASCII bytes in a UTF-8
rem  file get mis-decoded and can corrupt command parsing. Keep it
rem  English; Chinese instructions live in README.md.
rem
rem  NOTE 2: never end a line with "..." inside a parenthesized block
rem  (if / else). cmd parses BOTH branches up front, so a stray "..."
rem  in the branch that never runs still aborts the whole script with
rem  a syntax error. Dots are fine on top-level lines.
rem
rem  NOTE 3: avoid < and > inside blocks too - write PATH-TO-X instead.
rem
rem  NOTE 4: do not edit this file while it is running. cmd.exe re-reads
rem  from the byte offset it saved before each command, so editing it
rem  mid-run makes the next command start in the middle of an unrelated
rem  line. It looks exactly like a bug in the script: the long command
rem  "succeeds", then cmd complains that a fragment of a URL or a path
rem  is not a command. Wait for it to finish, then edit.
rem
rem  NOTE 5: keep CRLF line endings (see .gitattributes). cmd.exe copes
rem  with bare LF, but CRLF is what a .bat is supposed to be.
rem ==============================================================

set "MODE=%~1"
if "%MODE%"=="" set "MODE=run"

set "PORT=8790"
set "PY=.venv\Scripts\python.exe"
set "SRC=%TEMP%\recipe-nook-HowToCook"
set "DISHES=0"
set "HASTABLE=0"

echo.
echo ==== recipe-nook one-click setup ====
echo.

rem ---------- 0. prerequisites ----------
where python >nul 2>&1
if errorlevel 1 (
  where py >nul 2>&1
  if errorlevel 1 (
    echo [x] Python not found. Install Python 3.10+ and tick "Add to PATH".
    goto :fail
  )
)

rem ---------- 1. virtualenv ----------
if exist "%PY%" (
  echo [1/5] .venv already exists - skip
) else (
  echo [1/5] Creating .venv
  python -m venv .venv
  if errorlevel 1 (
    echo [x] Failed to create .venv
    goto :fail
  )
)

rem ---------- 2. dependencies ----------
"%PY%" -c "import fastapi, uvicorn, httpx" >nul 2>&1
if not errorlevel 1 (
  echo [2/5] Dependencies already installed - skip
) else (
  echo [2/5] Installing dependencies - this can take a few minutes
  "%PY%" -m pip install -q -r requirements.txt
  if errorlevel 1 (
    echo [x] pip install failed - check your network and re-run
    goto :fail
  )
)

rem ---------- 3. .env ----------
if exist ".env" (
  echo [3/5] .env already exists - skip
) else (
  echo [3/5] Creating .env - the LLM key for calorie estimates is optional
  copy /y .env.example .env >nul
)

rem ---------- 4. recipe library ----------
echo [4/5] Checking recipe library ...
rem  The count comes from a tiny Python helper instead of an inline "python -c":
rem  nesting double quotes inside a for /f backtick command breaks cmd's parser.
set "COUNTFILE=%TEMP%\recipe-nook-dishes.txt"
if exist "%COUNTFILE%" del /q "%COUNTFILE%" >nul
"%PY%" scripts\count_recipes.py > "%COUNTFILE%" 2>nul
set "DISHES=0"
if exist "%COUNTFILE%" set /p DISHES=<"%COUNTFILE%"

if "%MODE%"=="rebuild" (
  echo       rebuild requested - ignoring the existing library
  set "DISHES=0"
)

if !DISHES! GTR 0 (
  echo       !DISHES! dishes already in the library - skip build
  goto :after_build
)

echo       Library is empty - importing HowToCook, public domain, with images
where git >nul 2>&1
if errorlevel 1 (
  echo [x] git is required to build the library. Install Git, or download
  echo     HowToCook yourself and then run:
  echo       "%PY%" scripts\build_htc.py PATH-TO-HowToCook
  goto :fail
)

if not exist "%SRC%\dishes" (
  if exist "%SRC%\.git" (
    echo       An earlier download was interrupted - clearing it and retrying
    rmdir /s /q "%SRC%"
  )
  echo       Downloading HowToCook - about 100MB, a few minutes
  git clone --depth 1 https://github.com/Anduin2017/HowToCook.git "%SRC%"
  if errorlevel 1 (
    echo [x] Download failed - check your network and re-run
    goto :fail
  )
)

echo       Parsing recipes into the database ...
"%PY%" scripts\build_htc.py "%SRC%"
if errorlevel 1 (
  echo [x] Import failed
  goto :fail
)
echo       Source kept at %SRC% - rebuilds are much faster next time
rem  Count again: build_htc can exit 0 after importing nothing if the source
rem  it was pointed at is incomplete, and silently staying empty is worse
rem  than saying so.
if exist "%COUNTFILE%" del /q "%COUNTFILE%" >nul
"%PY%" scripts\count_recipes.py > "%COUNTFILE%" 2>nul
set "DISHES=0"
if exist "%COUNTFILE%" set /p DISHES=<"%COUNTFILE%"
if !DISHES! GTR 0 (
  echo       Imported !DISHES! dishes
) else (
  echo [!] Import finished but the library is still empty. The source may be
  echo     incomplete - delete %SRC% and run this script again.
)

:after_build
if "%MODE%"=="build" (
  echo.
  echo ==== Library build finished ====
  goto :ok
)

rem ---------- 5. start ----------
if "%MODE%"=="check" (
  echo.
  echo [5/5] Check mode - not starting. Run without arguments to start.
  goto :ok
)

netstat -ano | findstr ":%PORT%" | findstr /i "LISTENING" >nul
if not errorlevel 1 (
  echo [5/5] Port %PORT% is already in use - recipe-nook is probably running:
  echo       http://127.0.0.1:%PORT%/
  echo       Stop that process first if you want to restart it.
  goto :ok
)

echo [5/5] Starting recipe-nook ...
echo       http://127.0.0.1:%PORT%/
echo       Closing this window stops the service, and Ctrl+C works too.
echo.
"%PY%" -m uvicorn server:app --host 127.0.0.1 --port %PORT%
goto :ok

:fail
echo.
echo ==== Setup failed - see the [x] message above ====
endlocal
exit /b 1

:ok
echo.
endlocal
